<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: #f4f6f0;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="chart.Chart">
    <children>
        <VBox spacing="18.0" style="-fx-padding: 24 30 24 30;" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>

                <Label style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #d92b2b;" text="View Analytics" />

                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                    <children>

                        <!-- PIE CHART -->
                        <VBox alignment="CENTER" style="-fx-background-color: white; -fx-border-color: #6cbf6c; -fx-border-width: 1.5; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12;" HBox.hgrow="ALWAYS">
                            <children>
                                <PieChart fx:id="pieChart" prefHeight="200.0" prefWidth="220.0" title="Users type Distribution" />
                            </children>
                        </VBox>

                        <!-- BAR CHART -->
                        <VBox alignment="CENTER" style="-fx-background-color: white; -fx-border-color: #6cbf6c; -fx-border-width: 1.5; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12;" HBox.hgrow="ALWAYS">
                            <children>
                                <BarChart fx:id="barChart" prefHeight="200.0" prefWidth="220.0" title="Distribution of Deal Status">
                                    <xAxis>
                                        <CategoryAxis fx:id="xAxis" label="Deal Status" side="BOTTOM" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis fx:id="yAxis" label="Deals Count" side="LEFT" />
                                    </yAxis>
                                </BarChart>
                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>