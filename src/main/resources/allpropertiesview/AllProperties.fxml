<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f4f6f0;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="allproperties.AllProperties">
    <children>
        <VBox spacing="18.0" style="-fx-padding: 24 30 24 30;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <Label style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #d92b2b;" text="View Properties" />

                <!-- FILTER BAR -->
                <VBox spacing="12.0" style="-fx-background-color: white; -fx-border-color: #6cbf6c; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14;">
                    <children>

                        <!-- ROW 1: City -> Area -> Property Type -->
                        <HBox alignment="CENTER_LEFT" spacing="14.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2f4b8a;" text="City" />
                                <ComboBox fx:id="comboCity" onAction="#onCitySelected" prefHeight="30.0" prefWidth="180.0" promptText="Select City" />

                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2f4b8a;" text="Area" />
                                <ComboBox fx:id="comboArea" prefHeight="30.0" prefWidth="180.0" promptText="Select Area" />

                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2f4b8a;" text="Property Type" />
                                <ComboBox fx:id="comboPropertyType" prefHeight="30.0" prefWidth="200.0" promptText="Select Property Type">
                                </ComboBox>
                            </children>
                        </HBox>

                        <!-- ROW 2: Min Price -> Max Price -> Structure -> Show Properties -->
                        <HBox alignment="CENTER_LEFT" spacing="14.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2f4b8a;" text="Min Price" />
                                <TextField fx:id="txtMinPrice" prefHeight="30.0" prefWidth="120.0" promptText="Min Price" />

                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2f4b8a;" text="Max Price" />
                                <TextField fx:id="txtMaxPrice" prefHeight="30.0" prefWidth="120.0" promptText="Max Price" />

                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2f4b8a;" text="Structure" />
                                <ComboBox fx:id="comboStructure" prefHeight="30.0" prefWidth="180.0" promptText="Select Structure" />

                                <Button fx:id="btnShowProperties" onAction="#doShowProperties" style="-fx-background-color: #c8e6c9; -fx-text-fill: #205023; -fx-font-weight: bold; -fx-padding: 7 24 7 24;" text="Show Properties" />
                            </children>
                        </HBox>

                    </children>
                </VBox>

                <!-- TABLE (columns built at runtime in the controller) -->
                <VBox style="-fx-background-color: white; -fx-border-color: #6cbf6c; -fx-border-width: 1.5; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 18;" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tableProperties" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <!-- EXPORT -->
                <HBox alignment="CENTER" spacing="14.0" style="-fx-background-color: white; -fx-border-color: #6cbf6c; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14;">
                    <children>
                        <Button onAction="#exportToPdf" style="-fx-background-color: #eef2ff; -fx-text-fill: #4338ca; -fx-font-weight: bold; -fx-padding: 7 24 7 24;" text="Export as PDF" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
