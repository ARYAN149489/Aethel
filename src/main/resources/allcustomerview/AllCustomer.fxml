<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f4f6f0;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="allcustomer.AllCustomer">
    <children>
        <VBox spacing="18.0" style="-fx-padding: 24 30 24 30;" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>

                <Label style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #d92b2b;" text="View Customers" />

                <!-- FILTER BAR -->
                <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-background-color: white; -fx-border-color: #6cbf6c; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2f4b8a;" text="Customer Type" />
                        <ComboBox fx:id="comboCustomerType" prefHeight="30.0" prefWidth="220.0" promptText="Select Customer Type" />
                        <Button fx:id="btnShowCustomers" onAction="#doShowCustomers" style="-fx-background-color: #c8e6c9; -fx-text-fill: #205023; -fx-font-weight: bold; -fx-padding: 7 24 7 24;" text="Show Data" />
                    </children>
                </HBox>

                <!-- TABLE -->
                <VBox style="-fx-background-color: white; -fx-border-color: #6cbf6c; -fx-border-width: 1.5; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 18;" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tableCustomers" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colName" prefWidth="100.0" text="Name" />
                                <TableColumn fx:id="colMobile" prefWidth="100.0" text="Mobile" />
                                <TableColumn fx:id="colType" prefWidth="100.0" text="Type" />
                                <TableColumn fx:id="colEmail" prefWidth="150.0" text="Email" />
                                <TableColumn fx:id="colAddr" prefWidth="200.0" text="Address" />
                                <TableColumn fx:id="colCity" prefWidth="100.0" text="City" />
                                <TableColumn fx:id="colProfilePic" prefWidth="100.0" text="Profile Pic" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-background-color: white; -fx-border-color: #6cbf6c; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2f4b8a;" text="Export As" />
                        <Button onAction="#exportToExcel" style="-fx-background-color: #c8e6c9; -fx-text-fill: #205023; -fx-font-weight: bold; -fx-padding: 7 24 7 24;" text="Excel" />
                        <Button onAction="#exportToPdf" style="-fx-background-color: #eef2ff; -fx-text-fill: #4338ca; -fx-font-weight: bold; -fx-padding: 7 24 7 24;" text="PDF" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>