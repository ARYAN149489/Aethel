<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f4f6f0;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="alldeals.AllDeals">
    <children>
        <VBox spacing="18.0" style="-fx-padding: 24 30 24 30;" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>

                <Label style="-fx-font-size: 22px; -fx-font-weight: 800; -fx-text-fill: #d92b2b;" text="View Deals" />

                <!-- FILTER BAR -->
                <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-background-color: white; -fx-border-color: #6cbf6c; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2f4b8a;" text="Deal Status" />
                        <ComboBox fx:id="comboDealStatus" prefHeight="30.0" prefWidth="160.0" promptText="Select Status" />

                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2f4b8a;" text="Registry From" />
                        <DatePicker fx:id="dpFromDate" prefHeight="30.0" prefWidth="150.0" />

                        <Label style="-fx-font-weight: bold; -fx-text-fill: #2f4b8a;" text="Registry To" />
                        <DatePicker fx:id="dpToDate" prefHeight="30.0" prefWidth="150.0" />

                        <Button fx:id="btnShowDeals" onAction="#doShowDeals" style="-fx-background-color: #c8e6c9; -fx-text-fill: #205023; -fx-font-weight: bold; -fx-padding: 7 24 7 24;" text="Show Data" />
                    </children>
                </HBox>

                <!-- TABLE -->
                <VBox style="-fx-background-color: white; -fx-border-color: #6cbf6c; -fx-border-width: 1.5; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 18;" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tableDeals" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colBuyerMobile" prefWidth="100.0" text="Buyer Mobile" />
                                <TableColumn fx:id="colBuyerName" prefWidth="100.0" text="Buyer Name" />
                                <TableColumn fx:id="colSellerMobile" prefWidth="100.0" text="Seller Mobile" />
                                <TableColumn fx:id="colSellerName" prefWidth="100.0" text="Seller Name" />
                                <TableColumn fx:id="colPropertyName" prefWidth="130.0" text="Property Name" />
                                <TableColumn fx:id="colFinalAmount" prefWidth="100.0" text="Final Amount" />
                                <TableColumn fx:id="colMyCommission" prefWidth="100.0" text="My Commission" />
                                <TableColumn fx:id="colAmountLeft" prefWidth="100.0" text="Amount Left" />
                                <TableColumn fx:id="colCommissionLeft" prefWidth="110.0" text="Commission Left" />
                                <TableColumn fx:id="colAdvGivenDate" prefWidth="100.0" text="Adv Given Date" />
                                <TableColumn fx:id="colRegistryDate" prefWidth="100.0" text="Registry Date" />
                                <TableColumn fx:id="colOtherInfo" prefWidth="130.0" text="Other Info" />
                                <TableColumn fx:id="colDealStatus" prefWidth="100.0" text="Deal Status" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="14.0" style="-fx-background-color: white; -fx-border-color: #6cbf6c; -fx-border-width: 1.5; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 14;">
                    <children>
                        <Button onAction="#exportToPdf" style="-fx-background-color: #eef2ff; -fx-text-fill: #4338ca; -fx-font-weight: bold; -fx-padding: 7 24 7 24;" text="Export as PDF" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>